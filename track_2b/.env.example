# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
CSCS_API_KEY=
CSCS_BASE_URL=https://api.inference.cscs.ch/v1
# Run `python -m concordance doctor` to list the exact model ids on the endpoint, then set them here:
APERTUS_SMALL_MODEL=swiss-ai/Apertus-v1.5-8B
APERTUS_LARGE_MODEL=swiss-ai/Apertus-v1.5-70B
# Parallel requests; lower this if you hit rate limits (429)
CONCORDANCE_WORKERS=4
# Optional: serve the 70B model from a different server (on-prem / air-gapped setups)
# APERTUS_LARGE_BASE_URL=
